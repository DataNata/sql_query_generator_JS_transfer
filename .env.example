# Переменные окружения.
# На Netlify: Site configuration -> Environment variables (этот файл туда НЕ загружается).
# Локально: скопируйте в .env — его читает dev-server.mjs.
# Модели без ключа видны в селекторе с пометкой «нет ключа».

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# YandexGPT: API-ключ сервисного аккаунта + ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Ollama: публичный адрес OpenAI-совместимого API (с Netlify до localhost не достучаться).
# Локально можно указать http://localhost:11434/v1
# OLLAMA_BASE_URL=

# Пароль для входа в приложение (пусто = без пароля)
APP_PASSWORD=

# Секрет подписи cookie входа: длинная случайная строка, например результат
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Смена секрета = выход всех пользователей.
SESSION_SECRET=

# Только для локального запуска (dev-server.mjs)
# HOST=127.0.0.1
# PORT=8000
